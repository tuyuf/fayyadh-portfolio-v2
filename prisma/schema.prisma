generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model CaseStudyProject {
  id          String            @id @default(cuid())
  title       String
  subtitle    String?
  credits     String?
  description String
  link        String?
  category    CaseStudyCategory
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  images      CaseStudyImage[]

  @@index([deletedAt])
  @@index([sortOrder])
  @@index([category])
}

model CaseStudyImage {
  id           String           @id @default(cuid())
  projectId    String
  imageUrl     String
  cloudinaryId String
  caption      String?
  altText      String?
  width        Int?
  height       Int?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  project      CaseStudyProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sortOrder])
}

model PhotoItem {
  id           String    @id @default(cuid())
  imageUrl     String
  cloudinaryId String
  caption      String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([deletedAt])
  @@index([sortOrder])
}

model VideoItem {
  id          String    @id @default(cuid())
  title       String
  url         String
  thumbnail   String?
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([sortOrder])
}

model WebProject {
  id           String    @id @default(cuid())
  title        String
  description  String
  techStack    Json
  projectUrl   String?
  embedUrl     String?
  thumbnailUrl String?
  cloudinaryId String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  updatedAt    DateTime  @default(now()) @updatedAt

  @@index([deletedAt])
  @@index([sortOrder])
}

enum CaseStudyCategory {
  uiux
  brand
}

model Profile {
  id                String   @id @default(cuid())
  name              String
  role              String
  email             String?
  phone             String?
  birthDate         String?
  aboutText         String
  motto             String?
  photoUrl          String?
  photoCloudinaryId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EducationItem {
  id          String   @id @default(cuid())
  year        String
  institution String
  degree      String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([sortOrder])
}

model WorkItem {
  id          String   @id @default(cuid())
  year        String
  company     String
  position    String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([sortOrder])
}

model SkillCategory {
  id        String      @id @default(cuid())
  label     String
  title     String
  sortOrder Int         @default(0)
  skills    SkillItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([deletedAt])
  @@index([sortOrder])
}

model SkillItem {
  id          String        @id @default(cuid())
  categoryId  String
  name        String
  level       Int           @default(1)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  category    SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@index([deletedAt])
  @@index([sortOrder])
}

model Metric {
  id          String   @id @default(cuid())
  label       String
  value       String
  suffix      String?
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@index([deletedAt])
  @@index([sortOrder])
}
